<?xml version="1.0"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectName>{{PROJECT_NAME}}</ProjectName>
    <ProjectVersion>1.0.0</ProjectVersion>
    <ProjectDescription>A project built with EngineProject</ProjectDescription>
    <EngineDirectory>{{ENGINE_ROOT}}</EngineDirectory>
  </PropertyGroup>
  <PropertyGroup>
    <AssetsDirectory>Assets/</AssetsDirectory>
    <SceneDirectory>Assets/Scenes/</SceneDirectory>
    <ScriptsDirectory>Assets/Scripts/</ScriptsDirectory>
    <ShadersDirectory>{{ENGINE_ROOT}}/Engine/Core/Shaders/</ShadersDirectory>
    <BuildDirectory>build/</BuildDirectory>
  </PropertyGroup>
  <PropertyGroup>
    <CMakeGenerator>Visual Studio 17 2022</CMakeGenerator>
    <Platform>x64</Platform>
    <DefaultScene>Assets/Scenes/Basics/default.scene</DefaultScene>
    <ViewportWidth>1280</ViewportWidth>
    <ViewportHeight>720</ViewportHeight>
    <LeftPanelWidth>0.20</LeftPanelWidth>
    <RightPanelWidth>0.31</RightPanelWidth>
    <EditorHistoryLimit>100</EditorHistoryLimit>
    <EditorTheme>Graphite</EditorTheme>
  </PropertyGroup>
  <ItemGroup>
    <Scene Include="Assets/Scenes/Basics/default.scene" />
    <Scene Include="Assets/Scenes/Basics/default_2d.scene" />
  </ItemGroup>
  <ItemGroup>
    <LeftPanelTab Include="HierarchyView" />
    <CenterPanelTab Include="Scene" />
    <CenterPanelTab Include="Game" />
    <RightPanel Include="Properties" />
  </ItemGroup>
  <PropertyGroup>
    <RenderingAPI>DirectX11</RenderingAPI>
    <EditorRenderingAPI>DirectX11</EditorRenderingAPI>
    <GameRenderingAPI>DirectX11</GameRenderingAPI>
    <ClearColorR>0.18</ClearColorR>
    <ClearColorG>0.18</ClearColorG>
    <ClearColorB>0.18</ClearColorB>
    <ClearColorA>1.0</ClearColorA>
    <TargetFramerate>60</TargetFramerate>
    <BakedLightmapResolution>256</BakedLightmapResolution>
    <BakedShadowBias>0.002</BakedShadowBias>
    <BakedDilationPasses>4</BakedDilationPasses>
    <BakedPreserveSourceEmission>true</BakedPreserveSourceEmission>
    <RealtimeShadows Enabled="true" MaximumLights="1" DirectionalResolution="2048" DirectionalCascades="4" DirectionalDistance="150" PcfRadius="1" CascadeSplitLambda="0.65" CascadeTransitionFraction="0.1" PortalPolicy="0" PortalAtlasResolution="1024" PortalCascades="2" PortalViewBudget="2" />
    <DistanceLighting Enabled="true" MaximumDistance="1000" MaximumRealtimeLights="64" ClusteredLighting="true" ClusterTileSize="64" ClusterDepthSlices="16" MaximumLightsPerCluster="32">
      <Band Name="High" EndDistance="250" MaxRealtimeLights="64" NormalMapping="true" ParallaxMapping="true" EnvironmentDiffuse="true" Reflections="true" RealtimeShadows="true" ShadowDistanceScale="1" MaximumShadowPcfRadius="4" />
      <Band Name="Medium" EndDistance="600" MaxRealtimeLights="8" NormalMapping="true" ParallaxMapping="false" EnvironmentDiffuse="true" Reflections="false" RealtimeShadows="true" ShadowDistanceScale="0.65" MaximumShadowPcfRadius="1" />
      <Band Name="Low" EndDistance="1000" MaxRealtimeLights="2" NormalMapping="false" ParallaxMapping="false" EnvironmentDiffuse="false" Reflections="false" RealtimeShadows="false" ShadowDistanceScale="0" MaximumShadowPcfRadius="0" />
    </DistanceLighting>
  </PropertyGroup>
  <PropertyGroup>
    <AspectRatioMode>Free</AspectRatioMode>
    <GameAspectRatio>1.777</GameAspectRatio>
    <GameWindowWidth>1920</GameWindowWidth>
    <GameWindowHeight>1080</GameWindowHeight>
    <LetterboxColorR>0.0</LetterboxColorR>
    <LetterboxColorG>0.0</LetterboxColorG>
    <LetterboxColorB>0.0</LetterboxColorB>
    <LetterboxColorA>1.0</LetterboxColorA>
  </PropertyGroup>
  <ItemGroup>
    <BuiltInComponent Include="Transform" />
    <BuiltInComponent Include="Mesh" />
    <BuiltInComponent Include="Material" />
    <BuiltInComponent Include="Camera" />
  </ItemGroup>
</Project>
