      <position>
        <item>0</item>
        <item>0</item>
        <item>0</item>
      </position>
      <rotation>
        <item>0</item>
        <item>0</item>
        <item>0</item>
      </rotation>
      <scale>
        <item>1.75</item>
        <item>1.75</item>
        <item>1</item>
      </scale>
