{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Engine: Install VS Code Auto Attach",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
        "{{ENGINE_ROOT}}/Engine/Editor/VSCodeBridge/Install-VSCodeBridge.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"]
    },
    {
      "label": "CMake: Build Editor Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "Editor", "--parallel"],
      "dependsOn": "CMake: Configure Debug",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: Build Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--parallel"],
      "dependsOn": "CMake: Configure Debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Engine: Start Editor",
      "type": "process",
      "command": "${workspaceFolder}/build/Debug/Engine/Debug/Editor.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "CMake: Build Debug",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Engine: Open Project Hub",
      "type": "process",
      "command": "${workspaceFolder}/build/Debug/Engine/Debug/Editor.exe",
      "args": ["--project-hub"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "CMake: Build Debug",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
