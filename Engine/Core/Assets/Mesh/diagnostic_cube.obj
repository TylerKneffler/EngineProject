# Unit diagnostic cube centred at the origin.
# Vertex colors: -Z yellow, +Z blue, -X cyan, +X red, -Y magenta, +Y green.
# Each face owns four vertices so colors, normals, and UV islands stay hard-edged.

# Back (-Z): yellow
v -0.5 -0.5 -0.5  1.00 0.85 0.10
v -0.5  0.5 -0.5  1.00 0.85 0.10
v  0.5  0.5 -0.5  1.00 0.85 0.10
v  0.5 -0.5 -0.5  1.00 0.85 0.10
# Front (+Z): blue
v -0.5 -0.5  0.5  0.20 0.35 1.00
v  0.5 -0.5  0.5  0.20 0.35 1.00
v  0.5  0.5  0.5  0.20 0.35 1.00
v -0.5  0.5  0.5  0.20 0.35 1.00
# Left (-X): cyan
v -0.5 -0.5 -0.5  0.10 0.85 0.95
v -0.5 -0.5  0.5  0.10 0.85 0.95
v -0.5  0.5  0.5  0.10 0.85 0.95
v -0.5  0.5 -0.5  0.10 0.85 0.95
# Right (+X): red
v  0.5 -0.5 -0.5  1.00 0.15 0.15
v  0.5  0.5 -0.5  1.00 0.15 0.15
v  0.5  0.5  0.5  1.00 0.15 0.15
v  0.5 -0.5  0.5  1.00 0.15 0.15
# Bottom (-Y): magenta
v -0.5 -0.5 -0.5  1.00 0.20 1.00
v  0.5 -0.5 -0.5  1.00 0.20 1.00
v  0.5 -0.5  0.5  1.00 0.20 1.00
v -0.5 -0.5  0.5  1.00 0.20 1.00
# Top (+Y): green
v -0.5  0.5 -0.5  0.20 1.00 0.25
v -0.5  0.5  0.5  0.20 1.00 0.25
v  0.5  0.5  0.5  0.20 1.00 0.25
v  0.5  0.5 -0.5  0.20 1.00 0.25

vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0
vn  0 -1  0
vn  0  1  0

# Six non-overlapping atlas islands, retained for future texture diagnostics.
vt 0.000000 0.000000
vt 0.000000 0.500000
vt 0.333333 0.500000
vt 0.333333 0.000000
vt 0.333333 0.000000
vt 0.666667 0.000000
vt 0.666667 0.500000
vt 0.333333 0.500000
vt 0.666667 0.000000
vt 1.000000 0.000000
vt 1.000000 0.500000
vt 0.666667 0.500000
vt 0.000000 0.500000
vt 0.000000 1.000000
vt 0.333333 1.000000
vt 0.333333 0.500000
vt 0.333333 0.500000
vt 0.666667 0.500000
vt 0.666667 1.000000
vt 0.333333 1.000000
vt 0.666667 0.500000
vt 0.666667 1.000000
vt 1.000000 1.000000
vt 1.000000 0.500000

f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 5/5/2 6/6/2 7/7/2
f 5/5/2 7/7/2 8/8/2
