# Unit cube centred at the origin
# CCW winding viewed from outside (correct for DX12 LH pipeline:
# viewport Y-flip converts CCW-clip → CW-screen → front face with FrontCounterClockwise=FALSE)
# 8 vertices, 6 faces, 12 triangles

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0
vn  0 -1  0
vn  0  1  0

# Six non-overlapping UV islands (one per face) for baked lightmaps.
vt 0.000000 0.000000
vt 0.333333 0.000000
vt 0.333333 0.500000
vt 0.000000 0.500000
vt 0.333333 0.000000
vt 0.666667 0.000000
vt 0.666667 0.500000
vt 0.333333 0.500000
vt 0.666667 0.000000
vt 1.000000 0.000000
vt 1.000000 0.500000
vt 0.666667 0.500000
vt 0.000000 0.500000
vt 0.333333 0.500000
vt 0.333333 1.000000
vt 0.000000 1.000000
vt 0.333333 0.500000
vt 0.666667 0.500000
vt 0.666667 1.000000
vt 0.333333 1.000000
vt 0.666667 0.500000
vt 1.000000 0.500000
vt 1.000000 1.000000
vt 0.666667 1.000000

# Back  (-Z)  — faces camera at (0, 1.5, -3)
f 1/1/1 4/4/1 3/3/1
f 1/1/1 3/3/1 2/2/1
# Front (+Z)
f 5/5/2 6/6/2 7/7/2
f 5/5/2 7/7/2 8/8/2
# Left  (-X)
f 1/9/3 5/10/3 8/11/3
f 1/9/3 8/11/3 4/12/3
# Right (+X)
f 2/13/4 7/14/4 6/15/4
f 2/13/4 3/16/4 7/14/4
# Bottom (-Y)
f 1/17/5 6/19/5 5/20/5
f 1/17/5 2/18/5 6/19/5
# Top   (+Y)
f 4/21/6 8/24/6 7/23/6
f 4/21/6 7/23/6 3/22/6
