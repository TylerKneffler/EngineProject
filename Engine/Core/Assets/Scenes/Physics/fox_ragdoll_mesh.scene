<?xml version="1.0" encoding="utf-8"?>
<Scene xmlns:components="urn:engine-components" version="1">
  <settings dimension="0" showGrid="true" gridHalfSize="20" gridCellSize="1" gridOpacity="0.3" gridFadeDistance="100" skyboxTexture="Assets/Textures/Skyboxes/editor-default-sky.png">
