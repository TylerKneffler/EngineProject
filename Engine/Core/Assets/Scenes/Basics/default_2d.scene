  <settings dimension="1" showGrid="true" gridHalfSize="10" gridCellSize="1" gridOpacity="0.32" gridFadeDistance="80" skyboxTexture="">
    <gridColor _arrayEncoding="spaceSeparatedNumbers">0.5 0.5 0.5</gridColor>
