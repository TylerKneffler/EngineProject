    <ambientColor>
      <item>0.12</item>
      <item>0.12</item>
      <item>0.12</item>
    </ambientColor>
    <skyboxTexture></skyboxTexture>
  </settings>
  <objects>
    <item>
      <prefab>C:/Users/tyler/source/repos/EngineProject/Engine/Core/Assets/Prefabs/Slime.prefab</prefab>
      <enabled>true</enabled>
      <transform>
        <Transform.position>
          <item>0</item>
          <item>0</item>
          <item>0</item>
