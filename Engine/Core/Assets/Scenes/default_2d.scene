          <Camera.fov>60</Camera.fov>
          <Camera.near>0.01</Camera.near>
          <Camera.far>100</Camera.far>
          <Camera.orthographic>true</Camera.orthographic>
          <Camera.orthographicSize>5</Camera.orthographicSize>
