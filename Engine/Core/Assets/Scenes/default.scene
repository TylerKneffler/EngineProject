<?xml version="1.0" encoding="utf-8"?>
<Scene xmlns:components="urn:engine-components">
  <version>1</version>
  <settings>
    <settings.showGrid>true</settings.showGrid>
    <settings.gridHalfSize>10</settings.gridHalfSize>
    <settings.gridCellSize>1</settings.gridCellSize>
    <settings.gridOpacity>0.4</settings.gridOpacity>
    <settings.gridColor>
      <item>0.45</item>
      <item>0.45</item>
      <item>0.45</item>
    </settings.gridColor>
    <settings.gridOriginColor>
      <item>0.3</item>
      <item>0.5</item>
      <item>0.8</item>
    </settings.gridOriginColor>
    <settings.ambientColor>
      <item>0.12</item>
      <item>0.12</item>
      <item>0.12</item>
    </settings.ambientColor>
  </settings>
  <objects>
    <object>
      <object.name>Cube</object.name>
      <object.transform>
        <transform.position>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </transform.position>
        <transform.rotation>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </transform.rotation>
        <transform.scale>
          <item>1</item>
          <item>1</item>
          <item>1</item>
        </transform.scale>
      </object.transform>
      <object.components>
        <components:Mesh>
          <file>Assets/Mesh/cube.obj</file>
        </components:Mesh>
        <components:Material>
          <diffuse>
            <item>1</item>
            <item>0.5</item>
            <item>0.1</item>
          </diffuse>
          <ambient>
            <item>0.1</item>
            <item>0.1</item>
            <item>0.1</item>
          </ambient>
          <specular>
            <item>1</item>
            <item>1</item>
            <item>1</item>
          </specular>
          <shininess>32</shininess>
        </components:Material>
        <components:Rotate>
          <axis>
            <item>0</item>
            <item>1</item>
            <item>0</item>
          </axis>
          <speed>45</speed>
        </components:Rotate>
      </object.components>
      <object.children />
    </object>
  </objects>
</Scene>
