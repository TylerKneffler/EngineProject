<?xml version="1.0" encoding="utf-8"?>
<Scene xmlns:components="urn:engine-components">
  <version>1</version>
  <settings>
    <showGrid>true</showGrid>
    <gridHalfSize>10</gridHalfSize>
    <gridCellSize>1</gridCellSize>
    <gridOpacity>0.4</gridOpacity>
    <gridFadeDistance>80</gridFadeDistance>
    <gridColor>
      <item>0.45</item>
      <item>0.45</item>
      <item>0.45</item>
    </gridColor>
    <gridOriginColor>
      <item>0.3</item>
      <item>0.5</item>
      <item>0.8</item>
    </gridOriginColor>
    <ambientColor>
      <item>0.12</item>
      <item>0.12</item>
      <item>0.12</item>
    </ambientColor>
    <skyboxTexture></skyboxTexture>
  </settings>
  <objects>
    <item>
      <name>Cube</name>
      <enabled>true</enabled>
      <transform>
        <Transform.position>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </Transform.position>
        <Transform.rotation>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </Transform.rotation>
        <Transform.scale>
          <item>1</item>
          <item>1</item>
          <item>1</item>
        </Transform.scale>
      </transform>
      <components>
        <components:Mesh>
          <Mesh.file>Assets/Mesh/cube.obj</Mesh.file>
        </components:Mesh>
        <components:Material>
          <Material.diffuse>
            <item>1</item>
            <item>0.5</item>
            <item>0.1</item>
          </Material.diffuse>
          <Material.ambient>
            <item>0.1</item>
            <item>0.1</item>
            <item>0.1</item>
          </Material.ambient>
          <Material.specular>
            <item>1</item>
            <item>1</item>
            <item>1</item>
          </Material.specular>
          <Material.shininess>32</Material.shininess>
        </components:Material>
        <components:Rotate>
          <Rotate.axis>
            <item>0</item>
            <item>1</item>
            <item>0</item>
          </Rotate.axis>
          <Rotate.speed>45</Rotate.speed>
        </components:Rotate>
      </components>
      <children />
    </item>
    <item>
      <name>Camera</name>
      <enabled>true</enabled>
      <transform>
        <Transform.position>
          <item>0</item>
          <item>1.5</item>
          <item>-3</item>
        </Transform.position>
        <Transform.rotation>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </Transform.rotation>
        <Transform.scale>
          <item>1</item>
          <item>1</item>
          <item>1</item>
        </Transform.scale>
      </transform>
      <components>
        <components:Camera>
          <Camera.active>true</Camera.active>
          <Camera.fov>60</Camera.fov>
          <Camera.near>0.01</Camera.near>
          <Camera.far>100</Camera.far>
          <Camera.target>
            <item>0</item>
            <item>0</item>
            <item>0</item>
          </Camera.target>
          <Camera.up>
            <item>0</item>
            <item>1</item>
            <item>0</item>
          </Camera.up>
        </components:Camera>
      </components>
      <children />
    </item>
    <item>
      <name>Point Light</name>
      <enabled>true</enabled>
      <transform>
        <Transform.position>
          <item>1.5</item>
          <item>2</item>
          <item>-1</item>
        </Transform.position>
        <Transform.rotation>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </Transform.rotation>
        <Transform.scale>
          <item>1</item>
          <item>1</item>
          <item>1</item>
        </Transform.scale>
      </transform>
      <components>
        <components:Light>
          <Light.color>
            <item>1</item>
            <item>0.95</item>
            <item>0.85</item>
          </Light.color>
          <Light.intensity>4</Light.intensity>
          <Light.range>8</Light.range>
          <Light.falloff>2</Light.falloff>
          <Light.baked>false</Light.baked>
        </components:Light>
      </components>
      <children />
    </item>
  </objects>
</Scene>
