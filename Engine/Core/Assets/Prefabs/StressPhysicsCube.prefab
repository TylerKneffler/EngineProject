<?xml version="1.0" encoding="utf-8"?>
<Prefab xmlns:components="urn:engine-components">
  <version>1</version>
  <type>prefab</type>
  <object>
    <name>Stress Physics Cube</name><enabled>true</enabled>
    <transform><Transform.position><item>0</item><item>0</item><item>0</item></Transform.position><Transform.rotation><item>0</item><item>0</item><item>0</item></Transform.rotation><Transform.scale><item>1</item><item>1</item><item>1</item></Transform.scale></transform>
    <components>
      <components:Mesh><Mesh.file>Assets/Mesh/diagnostic_cube.obj</Mesh.file></components:Mesh>
      <components:Material><Material.materialAsset>Assets/Materials/diagnostic_cube.material</Material.materialAsset><Material.diffuse><item>0.22</item><item>0.62</item><item>0.95</item></Material.diffuse><Material.ambient><item>0.025</item><item>0.07</item><item>0.11</item></Material.ambient><Material.specular><item>0.8</item><item>0.9</item><item>1</item></Material.specular><Material.shininess>48</Material.shininess><Material.metallicFactor>0.2</Material.metallicFactor><Material.roughnessFactor>0.4</Material.roughnessFactor></components:Material>
      <components:PrimitiveObjectCollider><PrimitiveObjectCollider.collisionEnabled>true</PrimitiveObjectCollider.collisionEnabled><PrimitiveObjectCollider.center><item>0</item><item>0</item><item>0</item></PrimitiveObjectCollider.center><PrimitiveObjectCollider.shape>Box</PrimitiveObjectCollider.shape><PrimitiveObjectCollider.size><item>1</item><item>1</item><item>1</item></PrimitiveObjectCollider.size></components:PrimitiveObjectCollider>
      <components:RigidBody><RigidBody.bodyType>Dynamic</RigidBody.bodyType><RigidBody.mass>1</RigidBody.mass><RigidBody.useGravity>true</RigidBody.useGravity><RigidBody.gravityScale>1</RigidBody.gravityScale><RigidBody.linearDamping>0.08</RigidBody.linearDamping><RigidBody.angularDamping>0.1</RigidBody.angularDamping><RigidBody.friction>0.35</RigidBody.friction><RigidBody.restitution>0</RigidBody.restitution><RigidBody.continuousCollision>true</RigidBody.continuousCollision><RigidBody.collisionIdentifier>stress-cube</RigidBody.collisionIdentifier><RigidBody.frictionBehaviors><item match="Identifier" target="stress-floor" friction="0.72" enabled="true"/><item match="All" target="" friction="0.35" enabled="true"/></RigidBody.frictionBehaviors></components:RigidBody>
      <components:Cloth><Cloth.collisionMorph>true</Cloth.collisionMorph><Cloth.pinMode>None</Cloth.pinMode></components:Cloth>
    </components><children />
  </object>
</Prefab>
