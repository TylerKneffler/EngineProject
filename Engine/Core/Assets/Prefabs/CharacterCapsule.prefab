<?xml version="1.0" encoding="utf-8"?>
<Prefab xmlns:components="urn:engine-components">
  <version>1</version>
  <type>prefab</type>
  <object>
    <name>Character Capsule</name>
    <enabled>true</enabled>
    <transform>
      <Transform.position>
        <item>0</item>
        <item>1</item>
        <item>0</item>
      </Transform.position>
      <Transform.rotation>
        <item>0</item>
        <item>0</item>
        <item>0</item>
      </Transform.rotation>
      <Transform.scale>
        <item>1</item>
        <item>1</item>
        <item>1</item>
      </Transform.scale>
    </transform>
    <components>
      <components:Camera>
        <Camera.active>true</Camera.active>
        <Camera.useTransformRotation>true</Camera.useTransformRotation>
        <Camera.fov>70</Camera.fov>
        <Camera.near>0.05</Camera.near>
        <Camera.far>100</Camera.far>
        <Camera.orthographic>false</Camera.orthographic>
        <Camera.orthographicSize>5</Camera.orthographicSize>
        <Camera.target>
          <item>0</item>
          <item>0</item>
          <item>1</item>
        </Camera.target>
        <Camera.up>
          <item>0</item>
          <item>1</item>
          <item>0</item>
        </Camera.up>
      </components:Camera>
      <components:Mesh>
        <Mesh.file>Assets/Mesh/capsule.obj</Mesh.file>
      </components:Mesh>
      <components:Material>
        <Material.diffuse>
          <item>0.15</item>
          <item>0.55</item>
          <item>0.9</item>
        </Material.diffuse>
        <Material.ambient>
          <item>0.06</item>
          <item>0.08</item>
          <item>0.1</item>
        </Material.ambient>
        <Material.specular>
          <item>0.8</item>
          <item>0.9</item>
          <item>1</item>
        </Material.specular>
        <Material.shininess>48</Material.shininess>
      </components:Material>
      <components:PrimitiveObjectCollider>
        <PrimitiveObjectCollider.collisionEnabled>true</PrimitiveObjectCollider.collisionEnabled>
        <PrimitiveObjectCollider.center>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </PrimitiveObjectCollider.center>
        <PrimitiveObjectCollider.shape>Capsule</PrimitiveObjectCollider.shape>
        <PrimitiveObjectCollider.size>
          <item>0.5</item>
          <item>1</item>
          <item>0.5</item>
        </PrimitiveObjectCollider.size>
        <PrimitiveObjectCollider.radius>0.35</PrimitiveObjectCollider.radius>
        <PrimitiveObjectCollider.height>1.2</PrimitiveObjectCollider.height>
      </components:PrimitiveObjectCollider>
      <components:RigidBody>
        <RigidBody.bodyType>Dynamic</RigidBody.bodyType>
        <RigidBody.mass>1</RigidBody.mass>
        <RigidBody.useGravity>true</RigidBody.useGravity>
        <RigidBody.gravityScale>1</RigidBody.gravityScale>
        <RigidBody.linearDamping>0.2</RigidBody.linearDamping>
        <RigidBody.angularDamping>0.8</RigidBody.angularDamping>
        <RigidBody.friction>0.5</RigidBody.friction>
        <RigidBody.restitution>0.0</RigidBody.restitution>
        <RigidBody.isTrigger>false</RigidBody.isTrigger>
        <RigidBody.continuousCollision>false</RigidBody.continuousCollision>
        <RigidBody.initialLinearVelocity>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </RigidBody.initialLinearVelocity>
        <RigidBody.initialAngularVelocity>
          <item>0</item>
          <item>0</item>
          <item>0</item>
        </RigidBody.initialAngularVelocity>
        <RigidBody.freezePositionX>false</RigidBody.freezePositionX>
        <RigidBody.freezePositionY>false</RigidBody.freezePositionY>
        <RigidBody.freezePositionZ>false</RigidBody.freezePositionZ>
        <RigidBody.freezeRotationX>true</RigidBody.freezeRotationX>
        <RigidBody.freezeRotationY>false</RigidBody.freezeRotationY>
        <RigidBody.freezeRotationZ>true</RigidBody.freezeRotationZ>
        <RigidBody.collisionLayer>1</RigidBody.collisionLayer>
        <RigidBody.collisionMask>-1</RigidBody.collisionMask>
      </components:RigidBody>
      <components:FirstPersonController>
        <FirstPersonController.moveSpeed>4.5</FirstPersonController.moveSpeed>
        <FirstPersonController.sprintMultiplier>1.7</FirstPersonController.sprintMultiplier>
        <FirstPersonController.lookSensitivity>0.0025</FirstPersonController.lookSensitivity>
        <FirstPersonController.invertY>false</FirstPersonController.invertY>
        <FirstPersonController.lockCursor>true</FirstPersonController.lockCursor>
      </components:FirstPersonController>
    </components>
    <children />
  </object>
</Prefab>
