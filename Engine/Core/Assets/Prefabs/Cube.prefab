<?xml version="1.0" encoding="utf-8"?>
<Prefab xmlns:components="urn:engine-components">
  <version>1</version>
  <type>prefab</type>
  <object>
    <name>Cube</name>
    <enabled>true</enabled>
    <transform>
      <Transform.position>
        <item>0</item>
        <item>0</item>
        <item>0</item>
      </Transform.position>
      <Transform.rotation>
        <item>0</item>
        <item>0</item>
        <item>0</item>
      </Transform.rotation>
      <Transform.scale>
        <item>1</item>
        <item>1</item>
        <item>1</item>
      </Transform.scale>
    </transform>
    <components>
      <components:Mesh>
        <Mesh.file>Assets/Mesh/cube.obj</Mesh.file>
      </components:Mesh>
      <components:Material>
        <Material.diffuse>
          <item>1</item>
          <item>0.5</item>
          <item>0.1</item>
        </Material.diffuse>
        <Material.ambient>
          <item>0.1</item>
          <item>0.1</item>
          <item>0.1</item>
        </Material.ambient>
        <Material.specular>
          <item>1</item>
          <item>1</item>
          <item>1</item>
        </Material.specular>
        <Material.shininess>32</Material.shininess>
      </components:Material>
      <components:Rotate>
        <Rotate.axis>
          <item>0</item>
          <item>1</item>
          <item>0</item>
        </Rotate.axis>
        <Rotate.speed>45</Rotate.speed>
      </components:Rotate>
    </components>
    <children />
  </object>
</Prefab>
