{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug x64",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Debug/Editor.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole",
            "preLaunchTask": "CMake: Build Editor Debug",
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/build/Debug/lib/Debug",
                    "${workspaceFolder}/build/Debug/.hotreload"
                ]
            }
        },
        {
            "name": "Attach to Editor (Debug)",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/build/Debug/lib/Debug",
                    "${workspaceFolder}/build/Debug/.hotreload"
                ]
            }
        }
    ]
}
