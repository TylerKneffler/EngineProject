{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug x64",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Debug/Editor.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole",
            "preLaunchTask": "CMake: Build Editor Debug",
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/build/Debug/lib/Debug",
                    "${workspaceFolder}/build/Debug/.hotreload"
                ]
            }
        },
        {
            "name": "Dev Optimized x64 (fast + breakpoints)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/RelWithDebInfo/Editor.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            // Set ENGINE_GPU_DEBUG to "1" to turn on D3D11/D3D12 validation.
            "environment": [{ "name": "ENGINE_GPU_DEBUG", "value": "0" }],
            "console": "internalConsole",
            "preLaunchTask": "CMake: Build Editor Dev Optimized",
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/build/Debug/lib/RelWithDebInfo",
                    "${workspaceFolder}/build/Debug/.hotreload"
                ]
            }
        },
        {
            "name": "Release x64 (performance)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Release/Editor.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole",
            "preLaunchTask": "CMake: Build Editor Release (performance)"
        },
        {
            "name": "Attach to Editor (Debug)",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/build/Debug/lib/Debug",
                    "${workspaceFolder}/build/Debug/.hotreload"
                ]
            }
        }
    ]
}
